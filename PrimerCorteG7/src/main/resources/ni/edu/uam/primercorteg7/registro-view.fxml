<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0"
            prefWidth="850.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.primercorteg7.controllers.RegistroController">

    <top>
        <VBox alignment="CENTER" spacing="5.0">
            <padding>
                <Insets top="20.0" right="20.0" bottom="15.0" left="20.0"/>
            </padding>

            <Label text="Registro de Estudiantes">
                <font>
                    <Font size="24.0"/>
                </font>
            </Label>

            <Label text="Ingrese la información del estudiante"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="15.0">
            <padding>
                <Insets top="10.0" right="30.0" bottom="20.0" left="30.0"/>
            </padding>

            <GridPane hgap="15.0" vgap="12.0">

                <Label text="Código:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"/>

                <TextField fx:id="txtCodigo"
                           promptText="Código del estudiante"
                           prefWidth="250.0"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0"/>

                <Label text="Nombres:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"/>

                <TextField fx:id="txtNombres"
                           promptText="Nombres"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="1"/>

                <Label text="Apellidos:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="2"/>

                <TextField fx:id="txtApellidos"
                           promptText="Apellidos"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="2"/>

                <Label text="Carrera:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="3"/>

                <TextField fx:id="txtCarrera"
                           promptText="Carrera"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="3"/>

                <Label text="Fecha de nacimiento:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="4"/>

                <DatePicker fx:id="dpFechaNacimiento"
                            prefWidth="250.0"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="4"/>

            </GridPane>

            <HBox alignment="CENTER" spacing="15.0">

                <Button text="Guardar"
                        prefWidth="110.0"
                        onAction="#guardarEstudiante"/>

                <Button text="Limpiar"
                        prefWidth="110.0"
                        onAction="#limpiarCampos"/>

                <Button text="Regresar"
                        prefWidth="110.0"
                        onAction="#regresar"/>

            </HBox>

            <Separator/>

            <Label text="Estudiantes registrados">
                <font>
                    <Font size="16.0"/>
                </font>
            </Label>

            <TableView fx:id="tvEstudiantes"
                       VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn fx:id="colCodigo"
                                 text="Código"
                                 prefWidth="100.0"/>

                    <TableColumn fx:id="colNombres"
                                 text="Nombres"
                                 prefWidth="160.0"/>

                    <TableColumn fx:id="colApellidos"
                                 text="Apellidos"
                                 prefWidth="160.0"/>

                    <TableColumn fx:id="colCarrera"
                                 text="Carrera"
                                 prefWidth="190.0"/>

                    <TableColumn fx:id="colFechaNacimiento"
                                 text="Fecha de nacimiento"
                                 prefWidth="170.0"/>

                </columns>

            </TableView>

        </VBox>
    </center>

</BorderPane>