<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="550.0"
            prefWidth="850.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.primercorte7.Consulta_Estudiante">

    <top>
        <VBox alignment="CENTER" spacing="5.0">
            <padding>
                <Insets top="20.0" right="20.0" bottom="15.0" left="20.0"/>
            </padding>

            <Label text="Consulta de Estudiantes">
                <font>
                    <Font size="24.0"/>
                </font>
            </Label>

            <Label text="Estudiantes registrados en el sistema"/>

        </VBox>
    </top>

    <center>
        <VBox spacing="15.0">

            <padding>
                <Insets top="10.0" right="30.0" bottom="20.0" left="30.0"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="10.0">

                <Label text="Código:"/>

                <TextField fx:id="txtBuscarCodigo"
                           promptText="Ingrese el código"
                           prefWidth="220.0"/>

                <Button text="Buscar"
                        prefWidth="100.0"
                        onAction="#buscarEstudiante"/>

                <Button text="Mostrar todos"
                        prefWidth="120.0"
                        onAction="#mostrarTodos"/>

            </HBox>

            <Separator/>

            <TableView fx:id="tvEstudiantes"
                       VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn fx:id="colCodigo"
                                 text="Código"
                                 prefWidth="100.0"/>

                    <TableColumn fx:id="colNombres"
                                 text="Nombres"
                                 prefWidth="150.0"/>

                    <TableColumn fx:id="colApellidos"
                                 text="Apellidos"
                                 prefWidth="150.0"/>

                    <TableColumn fx:id="colCarrera"
                                 text="Carrera"
                                 prefWidth="220.0"/>

                    <TableColumn fx:id="colFechaNacimiento"
                                 text="Fecha de nacimiento"
                                 prefWidth="170.0"/>

                </columns>

            </TableView>

            <HBox alignment="CENTER_RIGHT" spacing="10.0">

                <Button text="Regresar"
                        prefWidth="110.0"
                        onAction="#regresar"/>

            </HBox>

        </VBox>
    </center>

</BorderPane>